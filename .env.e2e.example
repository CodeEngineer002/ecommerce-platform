# ── E2E Test Environment Variables ───────────────────────────────────────────
# Copy this file to .env.e2e and fill in values for your local environment.
# NEVER commit .env.e2e — it contains credentials.
#
# Load before running E2E tests:
#   set -a; source .env.e2e; set +a; npm run test:e2e

# ── Supabase (local instance) ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Service role key — used ONLY in Node.js test helpers for DB assertions.
# Never used in browser. Never exposed to client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=ShopNest
E2E_BASE_URL=http://localhost:4000

# ── Locale ────────────────────────────────────────────────────────────────────
# Country/language prefix used in all E2E storefront URLs.
# Must match a locale seeded in the database.
TEST_LOCALE_PREFIX=/in/en
TEST_COUNTRY_CODE=IN

# ── Test credentials (created by: npm run db:seed:e2e) ────────────────────────
TEST_CUSTOMER_EMAIL=e2e-customer@test.shopnest.local
TEST_CUSTOMER_PASSWORD=TestCustomer123!

TEST_ADMIN_EMAIL=e2e-admin@test.shopnest.local
TEST_ADMIN_PASSWORD=TestAdmin123!

# ── Test product ──────────────────────────────────────────────────────────────
# Slug of a product that is active, has stock, and exists in the test locale.
TEST_PRODUCT_SLUG=wireless-noise-cancelling-headphones

# ── Payment ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYMENT_PROVIDER=cod

# ── Safety guard ─────────────────────────────────────────────────────────────
# Set this ONLY if you are absolutely sure you are running against a test
# database, not production. Leave unset for localhost (default: safe).
# E2E_ALLOW_PRODUCTION=true

# ── Stripe (optional — only needed for stripe checkout tests) ─────────────────
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Email (disable in E2E to avoid sending real emails) ───────────────────────
EMAIL_PROVIDER=none
